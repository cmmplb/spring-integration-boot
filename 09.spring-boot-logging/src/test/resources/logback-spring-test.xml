<?xml version="1.0" encoding="UTF-8"?>

<!--
    scan: logback 配置文件一旦发生变化, logback 支持重新加载文件, 这是基于 logback 框架中一个后台线程实现的.
    scanPeriod: 默认情况下, logback 一分钟加载一次
-->
<!-- debug: 当此属性设置为 true 时, 将打印出 logback 内部日志信息, 实时查看 logback 运行状态. 默认值为 false -->
<configuration scan="true" scanPeriod="60 seconds" debug="false">

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>/Users/penglibo/Cmmplb/Logs/spring-boot-start/app1.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling File Appender -->
    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/Users/penglibo/Cmmplb/Logs/spring-boot-start/app2.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 解析配置文件过程中的详细调试信息, 记录 Logback 解析配置文件时的 SAX 事件 ( Simple API for XML ) -->
    <logger name="ch.qos.logback.core.joran.event.SaxEventRecorder" level="DEBUG"/>

    <springProperty scope="context" name="env" source="logback.env"/>

    <!-- Root Logger -->
    <root level="INFO">
        <if condition='property("env").equals("local")'>
            <then>
                <appender-ref ref="CONSOLE"/>
            </then>
            <else>
                <appender-ref ref="ROLLING"/>
            </else>
        </if>
    </root>
</configuration>